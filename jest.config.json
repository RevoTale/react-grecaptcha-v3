{
    "testMatch": ["**/__tests__/?(*.)(spec|test).(ts|jsx)?(x)"],
    "testEnvironment": "jsdom",
    "modulePathIgnorePatterns": ["<rootDir>/dist/"],
    "transform": {
        "^.+\\.(t|j)sx?$": [
            "@swc/jest",
            {
                "jsc": {
                    "parser": {
                        "syntax": "typescript",
                        "tsx": true
                    },
                    "transform": {
                        "react": {
                            "runtime": "automatic"
                        }
                    }
                }
            }
        ]
    }
}
